# Copy this file to .env and fill in real values for local development.
# .env is in .gitignore and should never be committed.

SECRET_KEY=change-this-to-a-random-string
FLASK_DEBUG=1
PORT=5000

# Leave unset for local dev (falls back to SQLite in the project folder).
# For deployment (e.g. Render with PostgreSQL) set this instead:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
